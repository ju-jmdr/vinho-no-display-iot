@model List<GarrafaViewModel>
@{ ViewData["Title"] = "Garrafas"; }
<div class="cabecalho">
    <div>
        <h1>Garrafas da adega</h1>
        <p>@Model.Sum(g => g.Quantidade) garrafa(s) em @Model.Count rótulo(s).</p>
    </div>
    <a class="btn btn-ouro" href="/Garrafa/Create">Nova garrafa</a>
</div>
<div class="cartao"><div class="tabela-rolagem">
@if (Model.Count == 0)
{
    <div class="aviso-vazio">Nenhuma garrafa cadastrada. Cadastre um perfil primeiro e depois seus vinhos.</div>
}
else
{
    <table class="tabela">
        <thead><tr><th>Cód.</th><th>Vinho</th><th>Produtor</th><th>Tipo</th><th>Safra</th><th>Qtde</th><th>Posição</th><th>Perfil</th><th></th></tr></thead>
        <tbody>
        @foreach (var g in Model)
        {
            <tr>
                <td>@g.Id</td><td>@g.Nome</td><td>@g.Produtor</td><td>@g.Tipo</td><td>@g.Safra</td>
                <td>@g.Quantidade</td><td>@g.Posicao</td><td>@g.NomePerfil</td>
                <td><div class="acoes">
                    <a class="btn btn-contorno btn-sm-acao" href="/Garrafa/Edit/@g.Id">Editar</a>
                    <a class="btn btn-contorno btn-sm-acao" href="/Garrafa/Delete/@g.Id" onclick="return confirm('Excluir esta garrafa?')">Excluir</a>
                </div></td>
            </tr>
        }
        </tbody>
    </table>
}
</div></div>
