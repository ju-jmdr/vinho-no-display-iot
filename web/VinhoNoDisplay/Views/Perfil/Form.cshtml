@model PerfilViewModel
@{ ViewData["Title"] = "Perfil"; string op = ViewBag.Operacao; }
<div class="cabecalho"><div><h1>@(op == "I" ? "Novo perfil" : "Editar perfil")</h1></div></div>
<div class="cartao" style="max-width:760px">
<form action="/Perfil/Save" method="post">
    <input type="hidden" name="Operacao" value="@op" />
    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
    <div class="row g-3">
        <div class="col-4 col-md-2">
            <label class="form-label" for="Id">Cód.</label>
            <input asp-for="Id" class="form-control" readonly />
            <span asp-validation-for="Id" class="text-danger"></span>
        </div>
        <div class="col-8 col-md-10">
            <label class="form-label" for="Nome">Nome</label>
            <input asp-for="Nome" class="form-control" maxlength="60" />
            <span asp-validation-for="Nome" class="text-danger"></span>
        </div>
        <div class="col-6 col-md-3"><label class="form-label" for="TempMin">Temp. mín. (°C)</label>
            <input asp-for="TempMin" type="number" step="0.1" class="form-control" />
            <span asp-validation-for="TempMin" class="text-danger"></span></div>
        <div class="col-6 col-md-3"><label class="form-label" for="TempMax">Temp. máx. (°C)</label>
            <input asp-for="TempMax" type="number" step="0.1" class="form-control" />
            <span asp-validation-for="TempMax" class="text-danger"></span></div>
        <div class="col-6 col-md-3"><label class="form-label" for="UmidMin">Umid. mín. (%)</label>
            <input asp-for="UmidMin" type="number" step="0.1" class="form-control" />
            <span asp-validation-for="UmidMin" class="text-danger"></span></div>
        <div class="col-6 col-md-3"><label class="form-label" for="UmidMax">Umid. máx. (%)</label>
            <input asp-for="UmidMax" type="number" step="0.1" class="form-control" />
            <span asp-validation-for="UmidMax" class="text-danger"></span></div>
        <div class="col-6 col-md-3"><label class="form-label" for="LuzMax">Luz máx. (%)</label>
            <input asp-for="LuzMax" type="number" step="0.1" class="form-control" />
            <span asp-validation-for="LuzMax" class="text-danger"></span></div>
    </div>
    <div class="d-flex gap-2 mt-4">
        <button type="submit" class="btn btn-ouro">Salvar</button>
        <a class="btn btn-contorno" href="/Perfil">Cancelar</a>
    </div>
</form>
</div>
