@model List<LeituraViewModel>
@if (Model.Count == 0)
{
    <div class="aviso-vazio">Nenhuma mensagem encontrada para este filtro.</div>
}
else
{
    <div class="dica mb-2">@Model.Count mensagem(ns)</div>
    <table class="tabela">
        <thead>
            <tr><th>Data/hora</th><th>Temperatura</th><th>Umidade</th><th>Luz</th><th>Situação</th></tr>
        </thead>
        <tbody>
        @foreach (var l in Model)
        {
            <tr class="@(l.TemAlarme ? "linha-alarme" : "")">
                <td>@l.DataHora.ToString("dd/MM/yyyy HH:mm:ss")</td>
                <td>@(l.Temperatura?.ToString("0.0") ?? "–") °C</td>
                <td>@(l.Umidade?.ToString("0.0") ?? "–") %</td>
                <td>@(l.Luminosidade?.ToString("0") ?? "–") %</td>
                <td>
                    @if (l.TemAlarme)
                    {
                        <span class="pilula perigo">@string.Join(", ", l.Causas())</span>
                    }
                    else
                    {
                        <span class="pilula ok">Normal</span>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
}
