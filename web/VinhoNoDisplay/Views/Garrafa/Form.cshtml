@model GarrafaViewModel
@{ ViewData["Title"] = "Garrafa"; string op = ViewBag.Operacao; }
<div class="cabecalho"><div><h1>@(op == "I" ? "Nova garrafa" : "Editar garrafa")</h1></div></div>
<div class="cartao" style="max-width:760px">
<form action="/Garrafa/Save" method="post">
    <input type="hidden" name="Operacao" value="@op" />
    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
    <div class="row g-3">
        <div class="col-4 col-md-2"><label class="form-label" for="Id">Cód.</label>
            <input asp-for="Id" class="form-control" readonly />
            <span asp-validation-for="Id" class="text-danger"></span></div>
        <div class="col-8 col-md-6"><label class="form-label" for="Nome">Vinho</label>
            <input asp-for="Nome" class="form-control" maxlength="60" />
            <span asp-validation-for="Nome" class="text-danger"></span></div>
        <div class="col-12 col-md-4"><label class="form-label" for="Produtor">Produtor</label>
            <input asp-for="Produtor" class="form-control" maxlength="60" />
            <span asp-validation-for="Produtor" class="text-danger"></span></div>
        <div class="col-6 col-md-4"><label class="form-label" for="Tipo">Tipo</label>
            <select asp-for="Tipo" asp-items="(List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.Tipos" class="form-select"></select>
            <span asp-validation-for="Tipo" class="text-danger"></span></div>
        <div class="col-6 col-md-2"><label class="form-label" for="Safra">Safra</label>
            <input asp-for="Safra" type="number" class="form-control" />
            <span asp-validation-for="Safra" class="text-danger"></span></div>
        <div class="col-6 col-md-2"><label class="form-label" for="Quantidade">Quantidade</label>
            <input asp-for="Quantidade" type="number" class="form-control" />
            <span asp-validation-for="Quantidade" class="text-danger"></span></div>
        <div class="col-6 col-md-4"><label class="form-label" for="Posicao">Posição</label>
            <input asp-for="Posicao" class="form-control" maxlength="30" />
            <span asp-validation-for="Posicao" class="text-danger"></span></div>
        <div class="col-12 col-md-6"><label class="form-label" for="PerfilId">Perfil de armazenamento</label>
            <select asp-for="PerfilId" asp-items="(List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.Perfis" class="form-select">
                <option value="0">Selecione…</option>
            </select>
            <span asp-validation-for="PerfilId" class="text-danger"></span></div>
    </div>
    <div class="d-flex gap-2 mt-4">
        <button type="submit" class="btn btn-ouro">Salvar</button>
        <a class="btn btn-contorno" href="/Garrafa">Cancelar</a>
    </div>
</form>
</div>
