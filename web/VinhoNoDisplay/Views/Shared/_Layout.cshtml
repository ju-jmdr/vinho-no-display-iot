<!DOCTYPE html>
<html lang="pt-BR" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · Vinho no Display</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    @{ var ctrl = (ViewContext.RouteData.Values["controller"] ?? "").ToString(); }
    <header class="topo">
        <div class="container-xl topo-interno">
            <a class="marca" href="/">
                <span class="marca-icone">🍷</span>
                <span class="marca-texto">Vinho no <em>Display</em></span>
            </a>
            <nav class="menu">
                <a class="@(ctrl == "Dashboard" ? "ativo" : "")" href="/">Painel</a>
                <a class="@(ctrl == "Mensagens" ? "ativo" : "")" href="/Mensagens">Mensagens IoT</a>
                <a class="@(ctrl == "Dispositivo" ? "ativo" : "")" href="/Dispositivo">Dispositivo</a>
                <a class="@(ctrl == "Perfil" ? "ativo" : "")" href="/Perfil">Perfis</a>
                <a class="@(ctrl == "Garrafa" ? "ativo" : "")" href="/Garrafa">Garrafas</a>
            </nav>
        </div>
    </header>

    <main class="container-xl conteudo">
        @RenderBody()
    </main>

    <footer class="rodape">Vinho no Display IoT · ESP32 + FIWARE + ASP.NET Core MVC · FIWARE em @VinhoNoDisplay.DAO.ConfiguracaoFiware.Host</footer>
    <div id="aviso" class="aviso" role="status"></div>

    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
